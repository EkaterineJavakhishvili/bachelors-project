# --- System & Environment ---
__pycache__/
*.py[cod]
.DS_Store
.venv/
.env
*.code-workspace

# --- Editor Configs ---
.vscode/
.idea/
*.swp

# --- DATA FILES (Ignore contents, keep folders) ---
# Ignore all heavy data files globally
*.csv
*.parquet
*.pkl
*.h5
*.zip

# Specific exclusions for data folder (redundant but safe)
data/raw/**/*.csv
data/interim/**/*.parquet
data/processed/**/*.parquet

# --- MODELS (Ignore large binaries) ---
models/*.pkl
models/*.joblib
models/*.keras

# --- EXCEPTIONS (Important!) ---
# Do NOT ignore .gitkeep files
!.gitkeep