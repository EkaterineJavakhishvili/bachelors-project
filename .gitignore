# --- Python & System ---
__pycache__/
*.pyc
.DS_Store
venv/
env/
.env
.vscode/
workspace/
.venv/
*.code-workspace

# --- Large Data Files (Excluded) ---
*.csv
*.parquet
*.h5
*.keras
*.zip

# --- Models (Excluded) ---
*.pkl
models/**/*.pkl
models/**/*.keras

# --- Reports & Figures (Excluded) ---
reports/figures/*.png
reports/figures/*.pdf
reports/figures/*.jpg

# --- BUT: Keep the Folder Structure! ---
# Ignore everything in these folders...
data/raw/*
data/processed/*
models/price_agent/*
reports/figures/*

# ...EXCEPT the .gitkeep files (This forces Git to upload the empty folder)
!**/.gitkeep
